# Kafka
KAFKA_INTERNAL_BOOTSTRAP=kafka:9092
KAFKA_EXTERNAL_PORT=29092
TOPIC_RAW=traffic.raw
TOPIC_METRICS=traffic.metrics
TOPIC_COMMANDS=control.commands

# ClickHouse
CLICKHOUSE_DB=traffic
CLICKHOUSE_USER=traffic_user
CLICKHOUSE_PASSWORD=change_me
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# Spark
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT_INTERNAL=8123
SPARK_WINDOW=10 seconds
SPARK_SLIDE=5 seconds
SPARK_WATERMARK=5 seconds

# Sözleşme taslağı (akşam kesinleşecek)
TOPIC_APPLIED=control.applied
TOPIC_RUN_EVENTS=run.events
SAMPLE_EVERY_STEPS=1
SIM_PACE=0.2